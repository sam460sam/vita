# Puppeteer is only a local demo/screenshot tool. Skip the heavy browser
# download on install (CI/Vercel). Locally run: npx puppeteer browsers install chrome
PUPPETEER_SKIP_DOWNLOAD=true

# @squareetlabs/capacitor-subscriptions declares a peer of @capacitor/core
# ^6 || ^7, but the app runs on Capacitor 8 (works fine in practice). Allow the
# install to resolve instead of failing with ERESOLVE.
legacy-peer-deps=true
